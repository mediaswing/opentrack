<?xml version="1.0" encoding="utf-8"?>
<!--
  The Windows Installer package (.msi) for Open Budget Tracker, built with WiX
  Toolset 6 by the windows job in .github/workflows/release.yml. It installs
  the files the workflow copies into its staging folder.

  Variables, given with -d on the wix build command line:
    Version      The version, from the tag (for example 1.0.0).
    StageDir     The folder holding opentrack.exe and its DLLs.
    RuntimeDlls  The Visual C++ runtime DLLs in StageDir, separated by
                 semicolons. The list comes from the exe's imports, so it can
                 change between releases.

  The app is installed for the current user only, in
  %LOCALAPPDATA%\Programs\OpenBudgetTracker, so no administrator rights are
  needed. Its settings, database and debug log live elsewhere
  (%APPDATA%\OpenBudgetTracker and %LOCALAPPDATA%\OpenBudgetTracker), and the
  installer never touches them, so the budget is kept through upgrades and
  uninstalling.

  Files under the user's profile can't be the key path of a component (ICE38),
  so each component has a registry value under
  HKEY_CURRENT_USER\Software\OpenBudgetTracker\Installer as its key path
  instead. WiX can't generate GUIDs for components like that, so each has a
  fixed GUID written here. Never change them.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!--
    Never change the UpgradeCode: it is how a new version finds and replaces
    the one already installed.
  -->
  <Package
      Name="Open Budget Tracker"
      Manufacturer="The Open Budget Tracker contributors"
      Version="$(var.Version)"
      UpgradeCode="887E8A1C-2745-41C4-9D27-158F60C96DDB"
      Scope="perUser"
      Language="1033">

    <!--
      The old version is removed before the new one is installed. Same-version
      upgrades are allowed so that a rebuilt package replaces the installed one
      rather than appearing a second time in the installed apps list.
    -->
    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of [ProductName] is already installed. To install this one, first uninstall the newer version from Installed apps in Windows Settings." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Shown in the installed apps list. -->
    <Icon Id="opentrack.ico" SourceFile="$(sys.SOURCEFILEDIR)..\..\assets\icon\opentrack.ico" />
    <Property Id="ARPPRODUCTICON" Value="opentrack.ico" />
    <Property Id="ARPCOMMENTS" Value="Open Budget Tracker: an accessible, keyboard-first budgeting tool" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/mediaswing/opentrack" />
    <Property Id="ARPHELPLINK" Value="https://github.com/mediaswing/opentrack/issues" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/mediaswing/opentrack/releases" />
    <!-- There is nothing to choose, so Installed apps offers only Uninstall and Repair. -->
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- Upgrade into the folder the previous version was installed in. -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKCU" Key="Software\OpenBudgetTracker\Installer" Name="InstallFolder" Type="raw" />
    </Property>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="OpenBudgetTracker" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="AppExe" Guid="6D357DCD-88F1-4CA9-A584-BD7188E037B7">
        <File Id="OpenTrackExe" Source="$(var.StageDir)\opentrack.exe" KeyPath="no" />
        <!-- A single Start menu shortcut, not in a folder. No desktop shortcut. -->
        <Shortcut
            Id="OpenTrackShortcut"
            Directory="ProgramMenuFolder"
            Name="Open Budget Tracker"
            Description="Open Budget Tracker: an accessible, keyboard-first budgeting tool"
            Target="[#OpenTrackExe]"
            WorkingDirectory="INSTALLFOLDER" />
        <!-- The installer's own key, removed with the app. The app's settings are not in it. -->
        <RegistryKey Root="HKCU" Key="Software\OpenBudgetTracker\Installer" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        </RegistryKey>
        <!-- Each folder goes only if it is empty, so other apps' folders in Programs are safe. -->
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
      </Component>

      <!--
        The Visual C++ runtime, so the app runs without the Redistributable.
        Which DLLs it needs can change between releases, so they share one
        component. That is safe because an upgrade removes the old version
        completely before installing the new one.
      -->
      <Component Id="VisualCppRuntime" Guid="98F3D434-3F45-47E1-8944-B8DF29280558">
        <?foreach Dll in $(var.RuntimeDlls)?>
        <File Id="RuntimeDll_$(var.Dll)" Source="$(var.StageDir)\$(var.Dll)" KeyPath="no" />
        <?endforeach?>
        <RegistryValue Root="HKCU" Key="Software\OpenBudgetTracker\Installer" Name="VisualCppRuntime" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="OpenBudgetTracker" Title="Open Budget Tracker" AllowAbsent="no" AllowAdvertise="no">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>

    <UIRef Id="OpenTrackUI" />
  </Package>

  <!--
    The standard WixUI dialogs, in the order of WixUI_Minimal but with the
    welcome page instead of the licence agreement: Welcome, Ready to install,
    progress, Finished. Running the .msi again leads to Repair or Remove.
    They are ordinary Windows Installer dialogs, so they work from the
    keyboard (Tab, Space, Enter, Escape) and with screen readers. The GPL
    doesn't need to be accepted to install or run the app, so it isn't shown
    as an agreement.
  -->
  <Fragment>
    <UI Id="OpenTrackUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="CancelDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />

      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
    </UI>

    <UIRef Id="WixUI_Common" />
  </Fragment>
</Wix>
